# Production Environment Variables for Render
# Copy these to your Render service environment variables

# Application Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Upstox API Configuration
# Get your access token from: https://developer.upstox.com/
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Telegram Bot Configuration
# Create a bot: message @BotFather on Telegram
# Get chat ID: message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Additional Configuration
# ALERT_COOLDOWN_MINUTES=5
# EMA_PERIOD=5
# CANDLE_INTERVAL_MINUTES=5
