# Environment configuration template for Render deployment
# Copy these variables to your Render service environment variables

# Required: Upstox API access token
# Get your access token from Upstox Developer Console
# https://developer.upstox.com/
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Optional: Telegram bot configuration (for alerts)
# Create a bot by messaging @BotFather on Telegram
# Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Application configuration
DEBUG=false
LOG_LEVEL=info
NODE_ENV=production

# Optional: Trading configuration
INSTRUMENT_KEY=NSE_INDEX|Nifty 50
CANDLE_INTERVAL=300000
EMA_PERIOD=5
ALERT_COOLDOWN_MINUTES=5

# System configuration (automatically set by Render)
PORT=10000
